# Optional external storage; placeholders only. Not loaded automatically.
PERSISTENCE_BACKEND=postgres-s3
DATABASE_URL=postgresql+psycopg://user:password@postgres.example:5432/target_info
S3_ENDPOINT_URL=https://minio.example
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_BUCKET=target-info-search
S3_REGION=us-east-1
S3_CREATE_BUCKET=false
APP_MASTER_KEY=replace-with-a-32-byte-urlsafe-base64-key
