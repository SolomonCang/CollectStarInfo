# Copy to .env.storage, change every password, then use:
# docker compose --env-file .env.storage -f docker-compose.storage.yml up -d --build
POSTGRES_DB=target_info
POSTGRES_USER=target_info
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=target-info
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
S3_BUCKET=target-info-search
S3_REGION=us-east-1
TARGET_INFO_PORT=8000
DEEPSEEK_API_KEY=
